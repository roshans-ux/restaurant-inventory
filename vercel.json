{
  "buildCommand": "npx prisma db push --accept-data-loss && npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/order-batch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/restock-check",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/weekly-slippage",
      "schedule": "30 4 * * 1"
    }
  ]
}
